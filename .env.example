DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# Shared secret required to view /admin/stats (access log + usage stats).
# Pass it as ?token=... or an `Authorization: Bearer ...` header. Pick
# something long and random - there is no username, just this token.
ADMIN_TOKEN=

# Cost per 1,000,000 AI API tokens, in USD — used only to display an
# estimated $ cost next to token counts on the /admin/stats history tab.
#
# Defaults live in pricing.py (deepseek-v4-pro 0.435/0.003625/0.870 per
# 1M input/cached/output, deepseek-v4-flash 0.140/0.0028/0.280, m3 placeholder).
# Re-verify these before trusting them in new work: vendor pricing is a
# vendor decision, not a constant. This repo has already been burned once
# by a number nobody re-checked (ai_client.MAX_OUTPUT_TOKENS, wrong for
# months), and the cache-hit rates in particular are what make the cost
# column on a long agent run legible — see
# docs/multifile-agent/06a-cache-snapshot-and-edits.md for why.
#
# Override any subset of the table by setting PRICING_JSON. Format: a JSON
# object mapping model name to [input_rate, cached_rate, output_rate] USD
# per 1M tokens. Example: only override the m3 placeholder:
#
#   PRICING_JSON={"MiniMax-M3":[0.30,0.005,0.60]}
#
# A single bad entry (wrong shape, non-numeric, typo'd key) is dropped with
# a warning — the rest of the table still applies, so a typo can't take
# the cost display down.

# Fine-grained GitHub Personal Access Token, scoped to just this repo
# (Contents: Read and write), used to auto-push generated/enhanced games.
# Create one at https://github.com/settings/personal-access-tokens/new
# Only required if git_sync.enabled: true in config.yaml.
GITHUB_PUSH_TOKEN=
