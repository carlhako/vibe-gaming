DEEPSEEK_API_KEY=

# Shared secret required to view /admin/stats (access log + usage stats).
# Pass it as ?token=... or an `Authorization: Bearer ...` header. Pick
# something long and random - there is no username, just this token.
ADMIN_TOKEN=

# Cost per 1,000,000 DeepSeek API tokens, in USD - used only to display an
# estimated $ cost next to token counts on the /admin/stats history tab.
# Dummy placeholder values below; replace with DeepSeek's real published
# per-model pricing before trusting the displayed costs.
DEEPSEEK_INPUT_COST_PER_MILLION=1.00
DEEPSEEK_OUTPUT_COST_PER_MILLION=2.00

# Input tokens DeepSeek served from its prefix cache bill at a small fraction
# of a fresh one. This is not a rounding detail: for deepseek-v4-pro a cache
# hit costs 1/120th of a miss ($0.003625 vs $0.435 per 1M, verified against
# DeepSeek's published pricing 2026-07-27; flash is 1/50, $0.0028 vs $0.14).
# Measured across three production agent enhances, cache-MISS input was 68-85%
# of the real bill while cache-HIT input was under 2%, so charging both at the
# same rate overstates a long agent run by ~4x and an explode by ~10x -- see
# docs/multifile-agent/06a-cache-snapshot-and-edits.md.
#
# RE-CHECK THIS before trusting it in new work: it is a vendor pricing
# decision, not a constant. This repo has been burned once already by a number
# nobody re-verified (ai_client.MAX_OUTPUT_TOKENS, wrong for months).
# Leave it unset and every input token bills at the rate above, which is
# exactly how /admin/stats behaved before Sprint 6a.
DEEPSEEK_CACHED_INPUT_COST_PER_MILLION=0.003625

# Fine-grained GitHub Personal Access Token, scoped to just this repo
# (Contents: Read and write), used to auto-push generated/enhanced games.
# Create one at https://github.com/settings/personal-access-tokens/new
# Only required if git_sync.enabled: true in config.yaml.
GITHUB_PUSH_TOKEN=
