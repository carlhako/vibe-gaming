# Copy to config.yaml and adjust as needed. Nothing here is secret — the
# DeepSeek API key lives in .env instead (see .env.example).

game_web:
  host: "0.0.0.0"
  port: 8600
  base_url: ""              # set to e.g. "https://games.example.com" once deployed behind a real host
  games_dir: "games"

# DeepSeek model reference (as of 2026-07-19 — see ai_client.py docstring):
# api.deepseek.com's GET /models currently exposes exactly two model
# families. Unlike the old deepseek-chat/deepseek-reasoner scheme, `model`
# no longer implies a reasoning depth — that's `effort` below, which toggles
# DeepSeek V4's per-request thinking mode on top of whichever model you pick.
#
#   deepseek-v4-flash   284B total / 13B active MoE, 1M context. Fast and
#                       cheap ($0.14/$0.28 per 1M tok, input/output, cache
#                       miss), with reasoning quality close to v4-pro when
#                       thinking mode is on. Good default for both new
#                       generation and enhancement.
#   deepseek-v4-pro     1.6T total / 49B active MoE, 1M context. Best raw
#                       quality for hard reasoning/agentic work, ~3x
#                       v4-flash's cost ($0.435/$0.87 per 1M tok). Worth
#                       trying if v4-flash output quality isn't cutting it.
#
# Legacy aliases (deepseek-chat -> v4-flash non-thinking mode,
# deepseek-reasoner -> v4-flash thinking mode) are RETIRED 2026-07-24 —
# don't use them in new configs; kept below only so you can see what they
# mapped to.

newaiwebgame:
  model: "deepseek-v4-flash"
  # model: "deepseek-v4-pro"
  # model: "deepseek-chat"        # DEPRECATED, retires 2026-07-24 — use deepseek-v4-flash + effort other than high/max
  # model: "deepseek-reasoner"    # DEPRECATED, retires 2026-07-24 — use deepseek-v4-flash + effort: high
  effort: "high"             # "high"/"max" -> thinking mode on (reasoning_effort); anything else -> fast non-thinking path, temperature pinned to 0.0
  timeout_seconds: 1800      # per ai_client.ask() call (30 min) — thinking-mode generations of a full game can run well past 120s
  max_attempts: 3            # 1 initial + 2 retries
  smoke_test_timeout_seconds: 20   # per generated-game Playwright headless load

enhanceaiwebgame:
  model: "deepseek-v4-flash"
  # model: "deepseek-v4-pro"
  # model: "deepseek-chat"        # DEPRECATED, retires 2026-07-24
  # model: "deepseek-reasoner"    # DEPRECATED, retires 2026-07-24
  effort: "high"             # enhancement/debugging is complex, keep thinking mode on
  timeout_seconds: 1800      # per ai_client.ask() call (30 min); see note above
  max_attempts: 3            # 1 initial + 2 retries; each failed attempt restores the backup first
  smoke_test_timeout_seconds: 20

# The ReAct editing agent (docs/multifile-agent/) used for enhance jobs
# whose SOURCE game is format: "multi-file" in its meta.json — single-file
# games keep using enhanceaiwebgame above, unchanged. The agent explores a
# game's src/ files with tools instead of resubmitting the whole game, so
# there's no output-ceiling-driven size note here the way LARGE_SOURCE_BYTES
# exists for enhanceaiwebgame.
multifile_agent:
  # v4-pro, not v4-flash, for this pass specifically. Exploding a 159KB
  # single-IIFE game is the hardest thing the agent does, and v4-flash
  # repeatedly failed to CONVERGE on it rather than failing on capability:
  # it split sensibly but then audited its own modules until it ran out of
  # steps, never once calling finish, so the run shipped nothing. v4-pro
  # reached verification in ~18 turns and passed. It is ~3.1x the token
  # price ($0.435/$0.87 vs $0.14/$0.28 per 1M) but was CHEAPER per run in
  # practice -- $0.35 vs $0.66 -- because it converges instead of thrashing.
  # See docs/multifile-agent/05-migration-and-pilot.md.
  #
  # This line is OPTIONAL: agent.DEFAULT_AGENT_MODEL is v4-pro in code, so a
  # deployment with no multifile_agent block at all still gets it. config.yaml
  # is gitignored, so a config-only default would never reach prod. Uncomment
  # the flash line to opt back out.
  # model: "deepseek-v4-flash"
  model: "deepseek-v4-pro"
  effort: "high"
  timeout_seconds: 1800        # per ai_client.ask_with_tools() call
  max_steps: 60                # hard cap on read/write/finish turns before giving up.
                               # Exploding a 159KB game took 12 module writes; a run
                               # that hits this cap before calling finish() verifies
                               # nothing and ships nothing, so leave real headroom.
  max_verification_retries: 3  # finish() calls that fail build->scan->smoke before giving up
  max_module_bytes: 450000     # 3x ai_client.MAX_OUTPUT_TOKENS bytes; see agent.py
  explode_max_module_bytes: 120000  # ceiling for the explode pass only. The 450000 above
                               # is a "can this be re-emitted at all" limit, not a target:
                               # a 159KB game once split "successfully" into a single 151KB
                               # module under it, passing every gate while leaving later
                               # edits as expensive as before the split. This started at
                               # 60000 and was raised because a ceiling the model has to
                               # dodge is worse than a loose one -- it shrinks a module to
                               # fit instead of splitting it, and drops code doing so
                               # (see docs/multifile-agent/05-migration-and-pilot.md).
                               # What actually drives granularity is the prompt's target
                               # module count, source_bytes / 25000.
  context_prune_after_steps: 6 # steps a read_file result rides along before being pruned.
                               # Was 3, raised because a wide change (a feature spanning
                               # ~7 modules) cycles back to a file many steps later, so a
                               # 3-step horizon pruned it just before reuse and forced a
                               # whole-file re-read -- the agent path's dominant token cost
                               # (job d6ca3a88 re-read config.js 10x, render.js 6x for one
                               # feature). Pruning also churns the prompt-cache prefix, so a
                               # re-read costs a full-price new turn AND a step where a
                               # resent-but-un-pruned read is mostly cached. Starting point;
                               # a size-aware horizon is a possible later refinement.
  # module_warn_bytes: 225000   # soft lint threshold (transcript note only, never blocks
                               # the write). Optional: defaults to half of whichever
                               # max_module_bytes ceiling applies to the current pass
                               # (agent.DEFAULT_MODULE_WARN_RATIO), so it also scales down
                               # automatically during explode's tighter 120000 ceiling.

# "Ask AI about this game" (kind='ask' jobs) — a single quick DeepSeek call,
# not a multi-attempt generation, so effort/timeout/max_tokens are tuned
# much lower than newaiwebgame/enhanceaiwebgame above. Its own rate_limit
# block keeps it from competing with real game generation's queue/budget
# (db.count_recent_generation_requests/count_active_generation_requests take
# a kind= filter for exactly this).
askaiwebgame:
  model: null                # null -> ai_client.MODEL_DEFAULT (deepseek-v4-flash)
  effort: null                # null -> fast non-thinking path; a lookup/summarize task doesn't need chain-of-thought
  timeout_seconds: 90
  max_tokens: 4000            # answers are short; bounds cost/latency
  rate_limit:
    max_requests: 20          # looser than generation's 5/hour — a much cheaper call
    window_seconds: 3600
    max_queue_size: 5

job_runner:
  workers: 1                 # poll-loop threads per process (dev) / per gunicorn worker (prod)
  poll_interval_seconds: 1   # how often an idle worker checks for a newly queued job

# Caps how often one visitor (by vg_uid cookie OR IP, whichever fires first —
# same anti-abuse posture as the ratings table's two UNIQUE constraints) can
# queue a /games/new or /enhance job, to bound worst-case DeepSeek token
# spend from a single abusive source. max_queue_size is a separate, global
# cap on total queued-or-generating jobs across ALL visitors at once — the
# per-visitor limit alone doesn't stop many different visitors from each
# queuing up to their own limit and piling up an unbounded backlog. Missing
# this block (or config.yaml entirely) falls back to these same defaults.
rate_limit:
  max_requests: 5
  window_seconds: 3600       # 1 hour
  max_queue_size: 5          # total queued+generating jobs allowed at once, across everyone
